<Window x:Class="TokNotch.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TokNotch.UI.Controls" Title="TokNotch 设置" Width="620" Height="660" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource InterfaceFont}" FontSize="12" UseLayoutRounding="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources><DataTemplate x:Key="ProviderNameTemplate"><TextBlock Text="{Binding Name}"/></DataTemplate>
  <Style x:Key="ActionButton" TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#93C5B2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="PasswordBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,8"/><Setter Property="Background" Value="{DynamicResource ControlBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/><Setter Property="Height" Value="38"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid x:Name="ComboShell"><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="9" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource HoverBackground}" BorderThickness="1"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="9" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboShell" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Switch" Width="34" Height="20" CornerRadius="10" Background="{DynamicResource ControlBorder}" Margin="0,0,12,0"><Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="{DynamicResource PositiveText}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="4" HorizontalAlignment="Center" CornerRadius="2" Background="{DynamicResource ControlBorder}" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="14"><Grid Margin="24,18,24,20"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="50"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragHeader"><TextBlock Text="TokNotch" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="设置" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="130,8,0,0"/><Button Content="✕" Click="CloseSettings" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" Style="{StaticResource ActionButton}" ToolTip="关闭"/></Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal"><Button x:Name="DisplayTab" Content="显示与排序" Click="ShowDisplay" Style="{StaticResource ActionButton}" Margin="0,0,6,10"/><Button x:Name="ConnectionTab" Content="数据连接" Click="ShowConnections" Style="{StaticResource ActionButton}" Margin="0,0,6,10"/><Button x:Name="AppearanceTab" Content="外观" Click="ShowAppearance" Style="{StaticResource ActionButton}" Margin="0,0,6,10"/><Button x:Name="PositionTab" Content="位置" Click="ShowPosition" Style="{StaticResource ActionButton}" Margin="0,0,6,10"/><Button x:Name="AnimationTab" Content="动画" Click="ShowAnimation" Style="{StaticResource ActionButton}" Margin="0,0,0,10"/></StackPanel>
  <c:SmoothScrollViewer x:Name="SettingsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly"><Grid Margin="0,4,6,14">
   <StackPanel x:Name="DisplayPage"><TextBlock Text="选择显示的三个来源" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="从五个来源中选择三个，用箭头调整窗口中的顺序。" Foreground="{DynamicResource TextMuted}" Margin="0,7,0,12"/>
    <StackPanel x:Name="ProviderSlots"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,16"/>
    <TextBlock Text="用量指标顺序" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Codex 按三行排序；DSH、MiMo 和 DeepSeek 的前两格按今日、本月的相对顺序排列，最后一格固定显示余额。Kimi 最后一格显示可用余额。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
    <StackPanel x:Name="MetricSlots"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,16"/>
    <TextBlock Text="圆环显示" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="为每个来源分别选择外圈与内圈；内圈可关闭。Token 圆环按下方设定的满圈值计算，今日占本月按百分比计算。没有数据时保持空轨道。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="设置来源" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="RingProviderBox" Grid.Column="1" AutomationProperties.Name="圆环设置来源" SelectionChanged="ChangeRingProvider"/></Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="外圈内容" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="OuterRingBox" Grid.Column="1" AutomationProperties.Name="外圈内容" SelectionChanged="ChangeRingContent"/></Grid>
    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="内圈内容" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="InnerRingBox" Grid.Column="1" AutomationProperties.Name="内圈内容" SelectionChanged="ChangeRingContent"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Token 满圈值" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="RingTokenBaselineBox" Grid.Column="1" AutomationProperties.Name="Token 满圈值" TextChanged="ChangeRingBaseline"/></Grid>
    <TextBlock x:Name="RingPreviewText" Foreground="{DynamicResource PositiveText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,16"/>
    <TextBlock Text="金额圆环满圈金额" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="选择余额、现金或赠金时，按金额 ÷ 满圈金额绘制。数值超过满圈时，圆心仍显示真实金额；Codex 额度环始终使用百分比。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="人民币满圈金额" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="BaselineCny" Grid.Column="1" AutomationProperties.Name="人民币满圈金额"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="美元满圈金额" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="BaselineUsd" Grid.Column="1" AutomationProperties.Name="美元满圈金额"/></Grid>
    <TextBlock Text="美元需单独填写：留空表示未设置，美元余额仍显示真实金额，但圆环不绘制比例，也不会套用人民币的 50 元。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,16"/>
    <TextBlock Text="刷新频率" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="界面刷新间隔：到期重新读取本机日志并更新浮岛，日志没变化时复用缓存、不重复解压。余额查询间隔：DSH、DeepSeek、MiMo、Kimi 两次官方查询之间的最短间隔，避免频繁请求。托盘“刷新真实数据”不受间隔限制，随时立即查询。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
    <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="界面刷新间隔（秒）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="RefreshSecondsBox" Grid.Column="1" AutomationProperties.Name="界面刷新间隔"/></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="余额查询间隔（秒）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="BalanceSecondsBox" Grid.Column="1" AutomationProperties.Name="余额查询间隔"/></Grid>
    <TextBlock Text="界面 5–3600 秒；余额 30–86400 秒。保存后立即生效，无需重启；圆环悬停提示显示最近一次刷新时刻。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,16"/>
    <TextBlock Text="快速操作" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="外观、位置和动画分别在上方独立页面设置。托盘右键也保留这些快速操作。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
    <StackPanel Orientation="Horizontal"><Button x:Name="RefreshNowButton" Content="立即刷新数据" Click="RefreshNow" Style="{StaticResource ActionButton}"/><Button x:Name="ShowIslandButton" Content="打开浮岛" Click="ShowIsland" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/><Button x:Name="ExitAppButton" Content="退出程序" Click="ExitApp" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Background="#4A2B2B" BorderBrush="#7E5555" Foreground="#F1F2F6"/></StackPanel>
    <TextBlock x:Name="CommandStatus" Foreground="{DynamicResource PositiveText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock x:Name="PreviewText" Foreground="{DynamicResource PositiveText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
    <TextBlock Text="外观" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="选择适合桌面的明暗主题与窗口材质。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,24"/>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="主题" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Column="1" AutomationProperties.Name="主题" SelectedIndex="0"><ComboBoxItem Content="深色"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="跟随 Windows"/></ComboBox></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="材质" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="MaterialBox" Grid.Column="1" AutomationProperties.Name="材质" SelectedIndex="0"><ComboBoxItem Content="液态玻璃（录屏隐藏）"/><ComboBoxItem Content="磨砂（可录屏）"/></ComboBox></Grid>
    <StackPanel Margin="0,24,0,0">
     <TextBlock Text="液态玻璃效果" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="折射模式" VerticalAlignment="Center"/><ComboBox x:Name="GlassMode" Grid.Column="1" AutomationProperties.Name="折射模式"><ComboBoxItem Content="Standard · 标准"/><ComboBoxItem Content="Polar · 极坐标"/><ComboBoxItem Content="Prominent · 强折射"/><ComboBoxItem Content="Shader · 动态位移"/></ComboBox></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="折射强度" VerticalAlignment="Center"/><Slider x:Name="GlassDisplacement" Grid.Column="1" Minimum="0" Maximum="120" AutomationProperties.Name="折射强度"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassDisplacement, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="磨砂" VerticalAlignment="Center"/><Slider x:Name="GlassBlur" Grid.Column="1" Minimum="0" Maximum="1" AutomationProperties.Name="磨砂"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassBlur, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="饱和度" VerticalAlignment="Center"/><Slider x:Name="GlassSaturation" Grid.Column="1" Minimum="0" Maximum="300" AutomationProperties.Name="饱和度"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassSaturation, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="色散" VerticalAlignment="Center"/><Slider x:Name="GlassAberration" Grid.Column="1" Minimum="0" Maximum="5" AutomationProperties.Name="色散"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassAberration, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="鼠标弹性" VerticalAlignment="Center"/><Slider x:Name="GlassElasticity" Grid.Column="1" Minimum="0" Maximum="1" AutomationProperties.Name="鼠标弹性"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassElasticity, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="圆角" VerticalAlignment="Center"/><Slider x:Name="GlassCornerRadius" Grid.Column="1" Minimum="0" Maximum="110" AutomationProperties.Name="圆角"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassCornerRadius, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><TextBlock Text="染色浓度" VerticalAlignment="Center"/><Slider x:Name="GlassTintOpacity" Grid.Column="1" Minimum="0" Maximum="1" AutomationProperties.Name="染色浓度"/><TextBlock Grid.Column="2" Text="{Binding Value, ElementName=GlassTintOpacity, StringFormat={}{0:0.##}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
<CheckBox x:Name="GlassOverLight" Content="浅色背景增强"/><Button Content="恢复演示效果" Click="ResetGlassMaterial" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
    <StackPanel Margin="0,24,0,0">
     <TextBlock Text="玻璃采样" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="展开后静止" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="ExpandedRateBox" Grid.Column="1" AutomationProperties.Name="展开后静止采样帧率" SelectionChanged="ChangeGlassRate"><ComboBoxItem Content="15 FPS"/><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="自定义"/><ComboBoxItem Content="跟随屏幕"/></ComboBox><TextBox x:Name="ExpandedCustomFps" Width="92" Grid.Column="2" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.Name="展开后静止自定义 FPS"/></Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="收起成胶囊" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="CollapsedRateBox" Grid.Column="1" AutomationProperties.Name="收起采样帧率" SelectionChanged="ChangeGlassRate"><ComboBoxItem Content="15 FPS"/><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="自定义"/><ComboBoxItem Content="跟随屏幕"/></ComboBox><TextBox x:Name="CollapsedCustomFps" Width="92" Grid.Column="2" Margin="8,0,0,0" Visibility="Collapsed" AutomationProperties.Name="收起自定义 FPS"/></Grid>
     <TextBlock Text="自定义范围 1–360 FPS，实际更新速度受屏幕刷新率限制。展开、收起动画与拖动期间跟随屏幕；锁屏、熄屏或休眠时暂停。降低帧率可以减少采样开销。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
    <Border Background="{DynamicResource MetricCard}" CornerRadius="12" Padding="16" Margin="0,22,0,0"><TextBlock Text="液态玻璃折射窗口下方的桌面，浮岛会从屏幕录制中隐藏。需要录制或分享浮岛时，选择磨砂。主题同时应用到浮岛和设置页。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/></Border>
   </StackPanel>
   <StackPanel x:Name="PositionPage" Visibility="Collapsed">
    <TextBlock Text="位置" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="浮岛靠屏幕边缘停靠，不遮挡桌面的主要内容。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,24"/>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="显示器模式" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="DisplayTargetBox" Grid.Column="1" AutomationProperties.Name="显示器模式" SelectionChanged="ChangeDisplayTarget" SelectedIndex="0"><ComboBoxItem Content="主显示器"/><ComboBoxItem Content="跟随鼠标所在显示器"/><ComboBoxItem Content="指定显示器"/></ComboBox></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="指定显示器" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="MonitorBox" Grid.Column="1" AutomationProperties.Name="指定显示器"/></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="停靠边缘" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="DockEdgeBox" Grid.Column="1" AutomationProperties.Name="停靠边缘" SelectedIndex="0"><ComboBoxItem Content="顶部"/><ComboBoxItem Content="底部"/><ComboBoxItem Content="左侧"/><ComboBoxItem Content="右侧"/></ComboBox></Grid>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="沿边位置（%）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="EdgeOffsetBox" Grid.Column="1" AutomationProperties.Name="沿边位置"/></Grid>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="边缘距离" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="EdgeMarginBox" Grid.Column="1" AutomationProperties.Name="边缘距离"/></Grid>
    <CheckBox x:Name="DragEnabledBox" Content="允许拖动浮岛" Foreground="{DynamicResource TextPrimary}"/>
    <TextBlock Text="沿边位置 50% 为居中，0% / 100% 为两端；边缘距离范围 0–100。拖动收起的胶囊或展开后的标题，松手自动靠到最近边缘并保存。拖动后固定到当前显示器。跟随鼠标模式仅在收起时换屏；显示器断开时回到主屏。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,16,0,18"/>
    <Button Content="恢复主屏顶部居中" Click="ResetPosition" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
   </StackPanel>
   <StackPanel x:Name="AnimationPage" Visibility="Collapsed">
    <TextBlock Text="动画与交互" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="选择展开方式和动画强度，避免频繁开合。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,24"/>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="展开方式" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="WindowModeBox" Grid.Column="1" AutomationProperties.Name="展开方式" SelectedIndex="0"><ComboBoxItem Content="悬停展开"/><ComboBoxItem Content="点击展开"/><ComboBoxItem Content="常驻展开"/></ComboBox></Grid>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="动画强度" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><ComboBox x:Name="AnimationModeBox" Grid.Column="1" AutomationProperties.Name="动画强度" SelectedIndex="0"><ComboBoxItem Content="正常"/><ComboBoxItem Content="减弱"/><ComboBoxItem Content="关闭"/></ComboBox></Grid>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="收起延迟（毫秒）" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/><TextBox x:Name="CollapseDelayBox" Grid.Column="1" AutomationProperties.Name="收起延迟"/></Grid>
    <Border Background="{DynamicResource MetricCard}" CornerRadius="12" Padding="16" Margin="0,22,0,0"><TextBlock Text="正常：轻微弹性回弹、分层渐显、数字与圆环平滑更新。减弱：120 毫秒短过渡，无弹簧回弹，数字和圆环直接更新。关闭：所有状态直接切换。Windows 关闭动画时也会直接切换。收起延迟仅用于悬停模式，可设 200–1000 毫秒。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/></Border>
   </StackPanel>
   <StackPanel x:Name="ConnectionPage" Visibility="Collapsed">
    <TextBlock Text="DeepSeek API" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="API key 查询账户余额，最后一格显示可用金额。DSH 余额关联：DeepSeek API —— DSH 行与这里共用同一次余额查询，DSH 的多模型 Token 总量不代表都从这个账户扣费。今日、本月 Token 仅统计本机 DSH 中明确标记为 DeepSeek API 的请求，不含网页登录和其他设备。官方暂无公开历史用量查询接口；请使用与日志对应的账户。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,7,0,12"/><PasswordBox x:Name="DeepSeekKey" AutomationProperties.Name="DeepSeek API key"/><StackPanel Orientation="Horizontal" Margin="0,12,0,8"><Button x:Name="ConnectDeepSeekButton" Content="连接 DeepSeek，查询余额" Click="ConnectDeepSeek" Style="{StaticResource ActionButton}"/><Button x:Name="ForgetDeepSeekButton" Content="清除已保存的 key" Click="ForgetDeepSeek" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="DeepSeekStatus" Foreground="{DynamicResource PositiveText}" TextWrapping="Wrap"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,22"/>
    <TextBlock Text="Kimi" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="中国大陆平台 API key · 查询可用、现金与赠金余额" Foreground="{DynamicResource TextMuted}" Margin="0,7,0,12"/><PasswordBox x:Name="KimiKey" AutomationProperties.Name="Kimi API key"/><StackPanel Orientation="Horizontal" Margin="0,12,0,8"><Button x:Name="ConnectKimiButton" Content="连接 Kimi" Click="ConnectKimi" Style="{StaticResource ActionButton}"/><Button x:Name="ForgetKimiButton" Content="清除已保存的 key" Click="ForgetKimi" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/></StackPanel><TextBlock x:Name="KimiStatus" Foreground="{DynamicResource PositiveText}" TextWrapping="Wrap"/>
    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,22,0,22"/><TextBlock Text="小米 MiMo" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="首次在内置页面登录小米账号，程序自动获取会话；以后启动自动连接。" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,7,0,12"/><StackPanel Orientation="Horizontal"><Button x:Name="AutoMimoButton" Content="登录 MiMo，自动连接" Click="AutoConnectMimo" Style="{StaticResource ActionButton}" Background="{DynamicResource ActionBackground}" BorderBrush="#557E6C"/><Button x:Name="DisconnectMimoButton" Content="断开" Click="DisconnectMimo" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/></StackPanel><Expander Header="手动 Cookie 连接（备用）" Foreground="#A4A9B8" Margin="0,14,0,0"><StackPanel><PasswordBox x:Name="MimoCookie" AutomationProperties.Name="MiMo Cookie" Margin="0,8,0,0"/><Button x:Name="ConnectMimoButton" Content="使用手动 Cookie" Click="ConnectMimo" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,10,0,8"/></StackPanel></Expander><TextBlock x:Name="MimoStatus" Foreground="{DynamicResource PositiveText}" TextWrapping="Wrap"/>
    <TextBlock Text="MiMo 登录会话由 Windows 加密保存。DSH 余额关联：DeepSeek API（不再跟随小米来源），DSH 行与 DeepSeek 行共用同一次余额查询与缓存；小米 MiMo 行只显示 MiMo 自己的控制台余额。Kimi 与 DeepSeek 的 API key 在首次成功连接后由 Windows DPAPI（当前用户）加密保存在本机 config/api-keys.bin，下次启动自动恢复，可用上方“清除已保存的 key”删除；key 不写入日志。任何能以本机该 Windows 用户身份运行的程序都可以解密该文件，请自行权衡。" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,26,0,0"/>
   </StackPanel>
  </Grid></c:SmoothScrollViewer>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveStatus" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" Text="保存后立即应用，重启仍保留。"/><Button x:Name="SavePreferencesButton" Grid.Column="1" Content="保存并应用" Click="SavePreferences" Style="{StaticResource ActionButton}" Background="{DynamicResource ActionBackground}" BorderBrush="#557E6C"/></Grid>
 </Grid></Border>
</Window>
