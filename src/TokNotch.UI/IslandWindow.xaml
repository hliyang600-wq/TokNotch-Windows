<Window x:Name="Island" x:Class="TokNotch.UI.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:TokNotch.UI.Controls" Title="TokNotch · Usage" Width="404" Height="240" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False" UseLayoutRounding="True">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibility"/></Window.Resources>
 <c:IslandSurface x:Name="Surface"><Canvas>
  <Grid x:Name="Compact" Width="180" Height="32"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse Width="4" Height="4" Fill="{Binding Accent}" Margin="0,0,8,0"/><TextBlock Text="{Binding CollapsedText}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/></StackPanel></Grid>
  <Grid x:Name="Expanded" Width="340" Height="168" Opacity="0" IsHitTestVisible="False" Margin="20,26,20,26">
   <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="100"/><RowDefinition Height="38"/></Grid.RowDefinitions>
   <Grid x:Name="HeaderRow"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DetailBadge}" Foreground="{DynamicResource TextSecondary}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/><Button Grid.Column="2" Click="OpenSettings" Style="{StaticResource ProviderButton}" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/></Button></Grid>
   <Grid x:Name="MetricsRow" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="RingRefreshButton" Click="RefreshRing" Cursor="Hand" AutomationProperties.Name="立即刷新用量和余额" AutomationProperties.HelpText="{Binding RingTooltip}"  Background="Transparent" BorderThickness="0" Padding="0"><Button.Template><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Button.Template><Grid Background="Transparent"><c:RingChart x:Name="UsageRing" Fraction="{Binding RingFraction}" InnerFraction="{Binding InnerRingFraction}" ShowInner="{Binding ShowInnerRing}" InnerAccent="{Binding RingInnerAccent}" Identity="{Binding RingIdentity}" Accent="{Binding Accent}" AnimationEnabled="{Binding AnimationsEnabled, ElementName=Island}"  Width="96" Height="96"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock x:Name="RingCenterTop" Text="{Binding RingCenterPrimary}" FontSize="{Binding RingCenterFontSize}" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="RingCenterBottom" Text="{Binding RingCenterSecondary}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RingInnerAccent}" HorizontalAlignment="Center" Visibility="{Binding ShowInnerRing, Converter={StaticResource BooleanToVisibility}}"/><TextBlock Text="{Binding CenterLabel}" FontSize="9" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Button>
    <Border Grid.Column="1" Margin="12,3,0,3" Padding="9,3" CornerRadius="10" Background="{DynamicResource MetricCard}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <Grid x:Name="FirstMetricRow"><TextBlock Text="{Binding FirstMetricLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/><c:AnimatedNumber Format="{Binding FirstMetricFormat}" x:Name="TodayNumber" Number="{Binding FirstMetricValue}" AnimationEnabled="{Binding AnimationsEnabled, ElementName=Island}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="19"/></Grid>
     <Grid Grid.Row="1" x:Name="SecondMetricRow"><TextBlock Text="{Binding SecondMetricLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/><c:AnimatedNumber Format="{Binding SecondMetricFormat}" x:Name="MonthNumber" Number="{Binding SecondMetricValue}" AnimationEnabled="{Binding AnimationsEnabled, ElementName=Island}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="19"/></Grid>
     <Grid Grid.Row="2" x:Name="ThirdMetricRow"><TextBlock Text="{Binding ThirdMetricLabel}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/><c:AnimatedNumber x:Name="TokensNumber" Number="{Binding ThirdMetricValue}" Format="{Binding ThirdMetricFormat}" AnimationEnabled="{Binding AnimationsEnabled, ElementName=Island}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="19"/></Grid>
    </Grid>
   </Border>
   </Grid>
   <UniformGrid x:Name="ProviderRow" Grid.Row="2" Columns="3" Margin="0,3,0,2"><Button Background="{Binding FirstProviderBackground}" x:Name="FirstProviderButton" Content="{Binding FirstProviderLabel}" Tag="{Binding FirstProvider}" Click="SelectProvider" Style="{StaticResource ProviderButton}"/><Button Background="{Binding SecondProviderBackground}" x:Name="SecondProviderButton" Content="{Binding SecondProviderLabel}" Tag="{Binding SecondProvider}" Click="SelectProvider" Style="{StaticResource ProviderButton}"/><Button Background="{Binding ThirdProviderBackground}" x:Name="ThirdProviderButton" Content="{Binding ThirdProviderLabel}" Tag="{Binding ThirdProvider}" Click="SelectProvider" Style="{StaticResource ProviderButton}"/></UniformGrid>
  </Grid>
 </Canvas></c:IslandSurface>
</Window>
